# Zoho OAuth — Self Client (backend WorkDrive API)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_DOMAIN=https://www.zohoapis.in
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in

# Zoho OAuth — Web Based Client (user login)
ZOHO_WEB_CLIENT_ID=
ZOHO_WEB_CLIENT_SECRET=
ZOHO_REDIRECT_URI=https://your-app.onrender.com/auth/callback

# Zoho WorkDrive
ZOHO_WORKDRIVE_TEAM_ID=
ZOHO_WORKDRIVE_ROOT_FOLDER_ID=

# App
FRONTEND_URL=https://your-app.onrender.com
PORT=3001

# Email notifications (Zoho Mail SMTP with App Password)
NOTIFICATION_EMAIL=
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAILS=
